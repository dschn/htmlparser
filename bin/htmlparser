#!/usr/bin/env ruby
# frozen_string_literal: true

# CLI for htmlparser gem. Usage: htmlparser test path
# Smoke only — not a conformance suite. Prefer rake conformance:*.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "htmlparser"

def run_test(path_or_dir)
  paths = if File.directory?(path_or_dir)
    Dir[File.join(path_or_dir, "*.html")]
  elsif File.file?(path_or_dir)
    [path_or_dir]
  else
    warn "Not found: #{path_or_dir}"
    return 1
  end

  paths.sort.each do |path|
    puts "=== #{path} ==="
    html = File.read(path)
    HTMLParser.parse(html)
    puts
  end
  0
end

case ARGV[0]
when "test"
  path = ARGV[1]
  if path.nil? || path.empty?
    warn "Usage: htmlparser test path"
    warn "  path: file or directory of .html files"
    exit 1
  end
  exit run_test(path)
else
  warn "Usage: htmlparser test path"
  warn "  path: file or directory of .html files"
  exit 1
end
